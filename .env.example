# Supabase (jfhjpeuobqyotcivovmb - same project as the rest of VoxIntel)
SUPABASE_URL=https://jfhjpeuobqyotcivovmb.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1XXXXXXXXXX
# SendGrid
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=alex@getvoxintel.com

# Slack - pick ONE approach:
# Option A: Bot token (recommended - supports the Slack-as-lead-intake flow)
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
SLACK_LEAD_CHANNEL_ID=
# Option B: Incoming webhook only (no Slack-events lead intake, notifications only)
SLACK_WEBHOOK_URL=

# Personalization used in templates
SDR_NAME=Alex
COMPANY_NAME=VoxIntel
# Protects the two cron endpoints. Set this, and also set it as a Vercel
# env var - Vercel automatically sends it as a Bearer token to your cron
# routes when CRON_SECRET is set as an env var on the project.
CRON_SECRET=
